{
  "schema": "openleo.sweep/2",
  "name": "Sampling and ray-trace refinement fidelity",
  "base_scenario": "../iridium_global_reference.json",
  "mode": "variants",
  "variants": [
    {
      "id": "step_30s",
      "label": "30 s sampling",
      "patch": [{"op": "replace", "path": "/time/step_s", "value": 30.0}]
    },
    {
      "id": "step_60s",
      "label": "60 s sampling (scenario default)",
      "baseline": true,
      "patch": [{"op": "replace", "path": "/time/step_s", "value": 60.0}]
    },
    {
      "id": "step_120s",
      "label": "120 s sampling",
      "patch": [{"op": "replace", "path": "/time/step_s", "value": 120.0}]
    },
    {
      "id": "refinement_2",
      "label": "60 s sampling, ray-trace refinement 2",
      "patch": [{"op": "replace", "path": "/propagation/refinement", "value": 2}]
    }
  ],
  "window": {"start_offset_s": 0, "duration_s": 1800}
}
