{
  "$id": "https://github.com/SodaFMR/openleo/schemas/scenario-2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "propagation": {
            "properties": {
              "model": {
                "const": "itu_reference"
              }
            },
            "required": [
              "model"
            ]
          }
        },
        "required": [
          "propagation"
        ]
      },
      "then": {
        "properties": {
          "ground_segment": {
            "else": {
              "properties": {
                "stations": {
                  "items": {
                    "properties": {
                      "minimum_elevation_deg": {
                        "minimum": 5.0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "minimum_elevation_deg"
                    ]
                  }
                }
              }
            },
            "if": {
              "properties": {
                "default_minimum_elevation_deg": {
                  "minimum": 5.0,
                  "type": "number"
                }
              },
              "required": [
                "default_minimum_elevation_deg"
              ]
            },
            "properties": {
              "stations": {
                "items": {
                  "properties": {
                    "height_amsl_m": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "height_amsl_m"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "stations": {
                  "items": {
                    "properties": {
                      "minimum_elevation_deg": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "minimum": 5.0
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "radio": {
            "properties": {
              "carrier_frequency_hz": {
                "maximum": 1000000000000.0,
                "minimum": 1000000000.0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "propagation": {
            "properties": {
              "hydrometeors": {
                "type": "object"
              }
            },
            "required": [
              "hydrometeors"
            ]
          }
        },
        "required": [
          "propagation"
        ]
      },
      "then": {
        "properties": {
          "radio": {
            "properties": {
              "carrier_frequency_hz": {
                "maximum": 200000000000.0,
                "minimum": 1000000000.0
              }
            }
          }
        }
      }
    }
  ],
  "description": "OpenLEO scenario document, format openleo.scenario/2. This schema checks structure, types, bounds and the cross-field rules JSON Schema can express. The OpenLEO parser (openleo.scenario.parse) is authoritative: it enforces every rule of this schema, except the stricter limits listed in (11), and the parser-only rules, which JSON Schema cannot express. Parser-only rules, and in (11) the stricter limits of the schema: (1) radio.channel_bandwidth_hz >= adaptation.symbol_rate_baud * (1 + adaptation.rolloff); (2) adaptation.symbol_rate_baud \u00d7 maximum MODCOD efficiency must be finite (overflow guard); (3) a station's terminal must name an entry of terminals ('default' when omitted); (4) station names must be unique; (5) pairs name ground stations, and the source and target of a pair differ; (6) hydrometeors.stations names every ground station exactly once, and each rain_top_height_amsl_m is at least that station's height_amsl_m; (7) time.stop_utc after start_utc, a window of at most 31 days, step_s at most the window and a whole number of microseconds, at most 1,000,000 samples including the stop point, and every timestamp a real calendar date; (8) step_s is at most one eighth of the shortest orbital period in the catalogs, which needs the catalogs and is checked when they are loaded; (9) the catalog sha256 matches the catalog file, there are no duplicate NORAD ids across catalogs, and the catalogs stay within their size limits (checked when they are read); (10) a scenario file of at most 1 MB with no duplicate JSON object keys and no non-finite numbers (properties of the JSON text, not of a parsed instance); (11) catalog URLs, where the schema refuses more than the parser: the schema pattern needs an ASCII host without brackets or control characters (write an internationalised host name as punycode, xn--) and no leading control character, so the parser alone accepts bracketed host literals of every kind (IPv6 and IPvFuture), non-ASCII hosts and those control characters. Also expressed by this schema with if/then/else, and listed because the parser is authoritative: (a) fixed_capacity_bps is present (not null) exactly when route_models lists fixed_capacity; (b) with propagation.model itu_reference, every station has height_amsl_m and an elevation mask, its own or the default, of at least 5 deg, and radio.carrier_frequency_hz lies in [1, 1000] GHz; (c) propagation.hydrometeors requires itu_reference and radio.carrier_frequency_hz in [1, 200] GHz.",
  "properties": {
    "adaptation": {
      "additionalProperties": false,
      "description": "Adaptive coding and modulation.",
      "properties": {
        "feedback_delay_s": {
          "default": 0.0,
          "description": "Delay before a measured Es/N0 changes the MODCOD. [s]",
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        "hysteresis_db": {
          "description": "Es/N0 margin required to step up a MODCOD. [dB]",
          "minimum": 0.0,
          "type": "number"
        },
        "implementation_margin_db": {
          "description": "Margin subtracted from Es/N0 before MODCOD selection. [dB]",
          "minimum": 0.0,
          "type": "number"
        },
        "rolloff": {
          "description": "Root-raised-cosine roll-off. [dimensionless]",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "standard": {
          "description": "Adaptive coding and modulation standard.",
          "enum": [
            "dvb-s2"
          ],
          "type": "string"
        },
        "symbol_rate_baud": {
          "description": "Symbol rate. [baud]",
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "table": {
          "description": "MODCOD table. S1 carries the five v1 reference rows.",
          "enum": [
            "v1-reference-subset"
          ],
          "type": "string"
        }
      },
      "required": [
        "standard",
        "table",
        "symbol_rate_baud",
        "rolloff",
        "implementation_margin_db",
        "hysteresis_db"
      ],
      "type": "object"
    },
    "description": {
      "default": "",
      "description": "Free text.",
      "type": "string"
    },
    "ground_segment": {
      "additionalProperties": false,
      "description": "Ground stations and elevation masks.",
      "properties": {
        "default_minimum_elevation_deg": {
          "description": "Elevation mask of stations that do not set their own. [deg]",
          "exclusiveMaximum": 90.0,
          "minimum": 0.0,
          "type": "number"
        },
        "stations": {
          "description": "Ground stations.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "height_amsl_m": {
                "anyOf": [
                  {
                    "maximum": 10000.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Height above mean sea level. Required when propagation.model is not free_space. [m]"
              },
              "height_ellipsoid_m": {
                "description": "Geometric height above the WGS84 ellipsoid. [m]",
                "type": "number"
              },
              "latitude_deg": {
                "description": "Geodetic latitude. [deg]",
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              "longitude_deg": {
                "description": "Geodetic longitude. [deg]",
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              "minimum_elevation_deg": {
                "anyOf": [
                  {
                    "exclusiveMaximum": 90.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Elevation mask. Null or omitted takes ground_segment.default_minimum_elevation_deg, resolved at parse. At least 5 when propagation.model is itu_reference. [deg]"
              },
              "name": {
                "description": "Unique station name; routes and hydrometeor states refer to it.",
                "minLength": 1,
                "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
                "type": "string"
              },
              "terminal": {
                "default": "default",
                "description": "Name of an entry of the scenario's terminals.",
                "minLength": 1,
                "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
                "type": "string"
              }
            },
            "required": [
              "name",
              "latitude_deg",
              "longitude_deg",
              "height_ellipsoid_m"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "default_minimum_elevation_deg",
        "stations"
      ],
      "type": "object"
    },
    "name": {
      "description": "Scenario title.",
      "minLength": 1,
      "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "type": "string"
    },
    "network": {
      "anyOf": [
        {
          "additionalProperties": false,
          "else": {
            "properties": {
              "fixed_capacity_bps": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "route_models": {
                "contains": {
                  "const": "fixed_capacity"
                }
              }
            },
            "required": [
              "route_models"
            ]
          },
          "properties": {
            "fixed_capacity_bps": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Ground-link capacity of the fixed_capacity baseline. Required exactly when route_models lists fixed_capacity, otherwise null or omitted. [bit/s]"
            },
            "isl": {
              "additionalProperties": false,
              "description": "Inter-satellite links.",
              "properties": {
                "capacity_bps": {
                  "description": "Capacity of every inter-satellite link. [bit/s]",
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                "max_range_m": {
                  "description": "Longest inter-satellite link; zero disables the links. [m]",
                  "minimum": 0.0,
                  "type": "number"
                },
                "rule": {
                  "description": "Inter-satellite link rule.",
                  "enum": [
                    "all_pairs_within_range"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "rule",
                "max_range_m",
                "capacity_bps"
              ],
              "type": "object"
            },
            "pairs": {
              "description": "Ordered source-target station pairs to route.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "description": "Name of the source station.",
                    "minLength": 1,
                    "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
                    "type": "string"
                  },
                  "target": {
                    "description": "Name of the target station, different from the source.",
                    "minLength": 1,
                    "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "target"
                ],
                "type": "object"
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "route_models": {
              "description": "Routing models to evaluate: a non-empty set of minimum_delay, maximum_rate and fixed_capacity.",
              "items": {
                "enum": [
                  "minimum_delay",
                  "maximum_rate",
                  "fixed_capacity"
                ],
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "pairs",
            "isl",
            "route_models"
          ],
          "then": {
            "properties": {
              "fixed_capacity_bps": {
                "type": "number"
              }
            },
            "required": [
              "fixed_capacity_bps"
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Routing between stations. Null or omitted disables routing."
    },
    "outputs": {
      "additionalProperties": false,
      "default": {},
      "description": "Result tables.",
      "properties": {
        "formats": {
          "default": [
            "csv",
            "olc"
          ],
          "description": "Table formats to write.",
          "items": {
            "enum": [
              "csv",
              "olc",
              "parquet"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "satellite_positions": {
          "default": "grid",
          "description": "Whether satellite positions are written at every grid sample.",
          "enum": [
            "grid",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "propagation": {
      "additionalProperties": false,
      "description": "Atmospheric propagation.",
      "else": {
        "properties": {
          "hydrometeors": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "model": {
            "const": "itu_reference"
          }
        },
        "required": [
          "model"
        ]
      },
      "properties": {
        "hydrometeors": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "model": {
                  "const": "declared_uniform_layers",
                  "description": "Hydrometeor model: declared uniform cloud and rain layers.",
                  "type": "string"
                },
                "stations": {
                  "additionalProperties": {
                    "additionalProperties": false,
                    "properties": {
                      "liquid_water_kg_m2": {
                        "description": "Integrated cloud liquid water of the column above the station. [kg/m^2]",
                        "minimum": 0.0,
                        "type": "number"
                      },
                      "polarization_tilt_deg": {
                        "description": "Polarisation tilt angle: 0 horizontal, 90 vertical. [deg]",
                        "maximum": 180.0,
                        "minimum": 0.0,
                        "type": "number"
                      },
                      "rain_rate_mm_h": {
                        "description": "Rain rate at the station. [mm/h]",
                        "minimum": 0.0,
                        "type": "number"
                      },
                      "rain_top_height_amsl_m": {
                        "description": "Height of the top of the uniform rain layer above mean sea level, at least the station's height_amsl_m. [m]",
                        "maximum": 20000.0,
                        "minimum": 0.0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "liquid_water_kg_m2",
                      "rain_rate_mm_h",
                      "rain_top_height_amsl_m",
                      "polarization_tilt_deg"
                    ],
                    "type": "object"
                  },
                  "description": "Declared state per ground station, keyed by station name. Every station appears exactly once.",
                  "minProperties": 1,
                  "propertyNames": {
                    "minLength": 1,
                    "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "required": [
                "model",
                "stations"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared uniform cloud and rain layers per station. Requires itu_reference."
        },
        "model": {
          "description": "Atmospheric propagation model.",
          "enum": [
            "free_space",
            "itu_reference"
          ],
          "type": "string"
        },
        "refinement": {
          "default": 1,
          "description": "Split-layer refinement of the ray trace. [dimensionless]",
          "enum": [
            1,
            2,
            4
          ],
          "type": "integer"
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    },
    "radio": {
      "additionalProperties": false,
      "description": "Downlink radio parameters.",
      "properties": {
        "carrier_frequency_hz": {
          "description": "Carrier frequency. [Hz]",
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "channel_bandwidth_hz": {
          "description": "Channel bandwidth, at least symbol_rate_baud * (1 + rolloff). [Hz]",
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "eirp_dbw": {
          "description": "Satellite effective isotropic radiated power. [dBW]",
          "type": "number"
        }
      },
      "required": [
        "carrier_frequency_hz",
        "channel_bandwidth_hz",
        "eirp_dbw"
      ],
      "type": "object"
    },
    "schema": {
      "const": "openleo.scenario/2",
      "description": "Document format version, exactly 'openleo.scenario/2'.",
      "type": "string"
    },
    "space_segment": {
      "additionalProperties": false,
      "description": "Orbital catalogs.",
      "properties": {
        "catalogs": {
          "description": "Orbital element catalogs, read by the engine and checked against their SHA-256.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "format": {
                "description": "Catalog file format.",
                "enum": [
                  "celestrak_gp_csv"
                ],
                "type": "string"
              },
              "path": {
                "description": "Catalog file. Relative paths resolve against the directory of the scenario file.",
                "minLength": 1,
                "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
                "type": "string"
              },
              "retrieved_at_utc": {
                "description": "Retrieval time, ISO 8601 UTC ending in Z.",
                "format": "date-time",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$(?!\\n)",
                "type": "string"
              },
              "sha256": {
                "description": "SHA-256 of the catalog file, 64 lowercase hexadecimal characters.",
                "maxLength": 64,
                "minLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "source_url": {
                "description": "Absolute HTTP(S) URL the catalog was retrieved from.",
                "format": "uri",
                "pattern": "^[hH][tT][tT][pP][sS]?://[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x41-\\x5a\\x5c\\x5e-\\x7e]+([\\/?#][^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*)?$(?!\\n)",
                "type": "string"
              },
              "terms_url": {
                "description": "Absolute HTTP(S) URL of the data provider's terms of use.",
                "format": "uri",
                "pattern": "^[hH][tT][tT][pP][sS]?://[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x41-\\x5a\\x5c\\x5e-\\x7e]+([\\/?#][^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*)?$(?!\\n)",
                "type": "string"
              }
            },
            "required": [
              "path",
              "format",
              "source_url",
              "retrieved_at_utc",
              "terms_url",
              "sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "select_norad_ids": {
          "anyOf": [
            {
              "items": {
                "maximum": 2147483647,
                "minimum": 1,
                "type": "integer"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NORAD catalog numbers to keep, or null for every object in the catalogs."
        },
        "synthetic_rf": {
          "description": "True when the radio block is declared rather than the named operator's real RF. Must be true when a real operator's catalog is paired with a declared RF block.",
          "type": "boolean"
        }
      },
      "required": [
        "catalogs",
        "synthetic_rf"
      ],
      "type": "object"
    },
    "terminals": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "miscellaneous_loss_db": {
            "description": "Fixed implementation and pointing loss. [dB]",
            "minimum": 0.0,
            "type": "number"
          },
          "receive_gain_dbi": {
            "description": "Receive antenna gain toward the satellite. [dBi]",
            "type": "number"
          },
          "system_noise_temperature_k": {
            "description": "Receive system noise temperature. [K]",
            "exclusiveMinimum": 0.0,
            "type": "number"
          }
        },
        "required": [
          "receive_gain_dbi",
          "system_noise_temperature_k",
          "miscellaneous_loss_db"
        ],
        "type": "object"
      },
      "description": "Named receive terminals. A station's terminal defaults to 'default'.",
      "propertyNames": {
        "minLength": 1,
        "pattern": "[^\\t-\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
        "type": "string"
      },
      "type": "object"
    },
    "time": {
      "additionalProperties": false,
      "description": "Time grid, events and convergence gate.",
      "properties": {
        "convergence": {
          "additionalProperties": false,
          "default": {},
          "description": "Grid convergence gate.",
          "properties": {
            "absolute_tolerance_bits": {
              "default": 1.0,
              "description": "Largest accepted absolute change of delivered bits under refinement. [bit]",
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "mode": {
              "default": "error",
              "description": "Reaction to a failed refinement gate. 'off' is recorded in every artefact.",
              "enum": [
                "error",
                "warn",
                "off"
              ],
              "type": "string"
            },
            "refinement_factor": {
              "default": 4,
              "description": "Factor by which the convergence gate refines the sample grid. [dimensionless]",
              "maximum": 16,
              "minimum": 2,
              "type": "integer"
            },
            "relative_tolerance": {
              "default": 0.01,
              "description": "Largest accepted relative change of a gated statistic under refinement. [dimensionless]",
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            }
          },
          "required": [],
          "type": "object"
        },
        "events": {
          "additionalProperties": false,
          "default": {},
          "description": "Event localisation.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Locate visibility, MODCOD and routing event instants within the tolerance.",
              "type": "boolean"
            },
            "tolerance_s": {
              "default": 0.001,
              "description": "Root-finding tolerance for event times. [s]",
              "maximum": 1.0,
              "minimum": 1e-06,
              "type": "number"
            }
          },
          "required": [],
          "type": "object"
        },
        "start_utc": {
          "description": "First sample time, ISO 8601 UTC ending in Z.",
          "format": "date-time",
